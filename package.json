{
  "name": "pdf-gen-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-monaco-assets.mjs && (pkill -f \"next\" 2>/dev/null || true && sleep 1 && lsof -ti:3030 | xargs kill -9 2>/dev/null || true && sleep 1 && next dev -p 3030)",
    "build": "node scripts/copy-monaco-assets.mjs && next build --turbo",
    "start": "next start",
    "lint": "eslint",
    "kill:port": "lsof -ti:3030 | xargs kill -9 2>/dev/null || true",
    "kill:next": "pkill -f \"next\" 2>/dev/null || true",
    "postinstall": "npx puppeteer browsers install chrome",
    "copy:monaco": "node scripts/copy-monaco-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "appwrite": "^21.5.0",
    "bullmq": "^6.7.7",
    "handlebars": "4.7.10",
    "jose": "^6.1.3",
    "monaco-editor": "0.58.0-dev-20261111",
    "next": "16.4.6",
    "node-appwrite": "^21.1.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "puppeteer": "25.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.6.0",
    "zod": "4.6.6"
  },
  "overrides": {
    "monaco-editor": "0.58.0-dev-20261111"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jszip": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
